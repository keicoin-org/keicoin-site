{
  "name": "keicoin-site",
  "version": "0.1.0",
  "private": true,
  "description": "keicoin.org — the site, on Cloudflare.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "bun run build.ts",
    "dev": "bun run build.ts && wrangler dev",
    "deploy": "bun run build.ts && wrangler deploy",
    "check": "bun run build.ts && wrangler deploy --dry-run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^5.9.0",
    "wrangler": "^4.0.0"
  }
}
