{
  "name": "keicoin-site",
  "version": "0.1.0",
  "private": true,
  "description": "keicoin.org — the site, on Cloudflare.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "bun run build:site && bun run build:docs",
    "build:site": "bun run build.ts",
    "build:docs": "vitepress build docs",
    "dev": "bun run build && wrangler dev",
    "docs:dev": "vitepress dev docs",
    "docs:preview": "vitepress preview docs",
    "deploy": "bun run build && wrangler deploy",
    "check": "bun run build && wrangler deploy --dry-run",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "kei-transaction": "0.1.0",
    "typescript": "^5.9.0",
    "vitepress": "1.6.4",
    "wrangler": "^4.0.0"
  }
}
